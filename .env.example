# Copy to .env (`make env`). Values below are the Supabase CLI local defaults (not secrets).

# --- Backend (app/backend) ---
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Supabase Auth: the API verifies access tokens against this project's JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Beta allowlist of GitHub usernames (comma-separated). Empty lets anyone sign in.
ALLOWED_GITHUB_USERS=

# --- Supabase local stack (read by `supabase start`) ---
# GitHub OAuth app for "Sign in with GitHub". Callback URL: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- Frontend (app/frontend, read by Vite; baked in at build time) ---
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
