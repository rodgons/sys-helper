# Copy to .env (`make env`). Values below are the Supabase CLI local defaults (not secrets).

# --- Backend (app/backend) ---
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Supabase Auth: the API verifies access tokens against this project's JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Beta allowlist of GitHub usernames (comma-separated). Empty lets anyone sign in.
ALLOWED_GITHUB_USERS=

# AI: an OpenAI-compatible endpoint (NVIDIA's API catalog). Get a key at https://build.nvidia.com.
# Without a key the API runs, but AI replies answer "not set up".
NVIDIA_API_KEY=
# Model IDs from https://integrate.api.nvidia.com/v1/models. AI_MODEL is required with a key; the
# fallback answers when AI_MODEL hasn't started replying within AI_FIRST_TOKEN_TIMEOUT (empty = none).
# Measured 2026-09-30: GLM-5.3 0.8s and GPT-OSS-20B 0.4s to the first token; Kimi K3 took 60s and
# Gemma 4 31B didn't answer. `make test-ai-live` checks the models set here.
AI_MODEL=z-ai/glm-5.3
AI_FALLBACK_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_FIRST_TOKEN_TIMEOUT=20s
# AI_DAILY_MESSAGE_LIMIT=100                (messages per user per UTC day; 0 = no cap)
# AI_FAKE=1                                 (canned replies, no network; E2E sets this)

# --- Supabase local stack (read by `supabase start`) ---
# GitHub OAuth app for "Sign in with GitHub". Callback URL: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- Frontend (app/frontend, read by Vite; baked in at build time) ---
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
