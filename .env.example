# Copy to .env (`make env`). Values below are the Supabase CLI local defaults (not secrets).

# --- Backend (app/backend) ---
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Supabase Auth: the API verifies access tokens against this project's JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Beta allowlist (comma-separated). A User is admitted if any of their identities is listed. Both
# empty admit nobody; ALLOW_ALL_USERS=1 admits everyone (ALLOW_ALL_GITHUB_USERS was removed).
# ALLOWED_GITHUB_IDS: numeric GitHub user ids (https://api.github.com/users/<name> shows "id").
# ALLOWED_GOOGLE_IDS: Google account ids ("sub"), never emails. The not-allowed page shows a
# signed-in person their Google id, so they can send it to you.
ALLOWED_GITHUB_IDS=
ALLOWED_GOOGLE_IDS=
ALLOW_ALL_USERS=

# AI: OpenRouter's free models (https://openrouter.ai/settings/keys). The API lists them at startup
# and every AI_MODELS_REFRESH, keeps the ones that can call tools with enough context, and tries the
# best first, moving on when one is rate-limited, failing or slow (AI_FIRST_TOKEN_TIMEOUT). The
# account's privacy settings must allow free endpoints, which may log or train on prompts.
# Without the key the API runs, but AI replies answer "unavailable". `make test-ai-live` checks the
# best few models.
OPENROUTER_API_KEY=
# AI_MODELS=                                (pins free models in order, e.g. vendor/a:free,vendor/b:free; skips discovery)
# AI_EXCLUDE_MODELS=                        (free models never to use)
# AI_MODELS_REFRESH=1h
# AI_FIRST_TOKEN_TIMEOUT=20s
# AI_DAILY_REPLY_LIMIT=100                  (model calls per user per UTC day, retries included; 0 = no cap)
# AI_GLOBAL_DAILY_LIMIT=50                  (requests to OpenRouter per UTC day for all users, fallbacks included;
#                                            the free quota is 50/day, or 1000/day after buying $10 of credit; 0 = no cap)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_FAKE=1                                 (canned replies, no network; E2E sets this)

# --- Supabase local stack (read by `supabase start`) ---
# GitHub OAuth app for "Sign in with GitHub". Callback URL: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Google OAuth client for "Sign in with Google" (Google Cloud console > Credentials > OAuth client
# ID, web application). Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback. Optional:
# without it only the Google button fails.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Frontend (app/frontend, read by Vite; baked in at build time) ---
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
