# Copy to .env (`make env`). Values below are the Supabase CLI local defaults (not secrets).

# --- Backend (app/backend) ---
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Supabase Auth: the API verifies access tokens against this project's JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Beta allowlist of numeric GitHub user ids (comma-separated; https://api.github.com/users/<name>
# shows a user's "id"). Empty admits nobody. ALLOW_ALL_GITHUB_USERS=1 admits every GitHub account.
ALLOWED_GITHUB_IDS=

# AI: an OpenAI-compatible endpoint from AI_PROVIDER: nvidia (default) or gemini. Each reads its own
# key: NVIDIA_API_KEY (https://build.nvidia.com) or GEMINI_API_KEY (https://aistudio.google.com/apikey).
# Without the provider's key the API runs, but AI replies answer "not set up".
AI_PROVIDER=gemini
NVIDIA_API_KEY=
GEMINI_API_KEY=
# AI_MODEL is required with a key; the fallback (same provider) answers when AI_MODEL hasn't started
# replying within AI_FIRST_TOKEN_TIMEOUT (empty = none). `make test-ai-live` checks the models set here.
# Gemini model IDs: https://ai.google.dev/gemini-api/docs/models
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
# NVIDIA model IDs: https://integrate.api.nvidia.com/v1/models. Measured 2026-09-30: GLM-5.3 0.8s and
# GPT-OSS-20B 0.4s to the first token; Kimi K3 took 60s and Gemma 4 31B didn't answer.
# AI_MODEL=z-ai/glm-5.3
# AI_FALLBACK_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=                              (defaults to the provider's endpoint)
# AI_FIRST_TOKEN_TIMEOUT=20s
# AI_DAILY_REPLY_LIMIT=100                  (model calls per user per UTC day, retries included; 0 = no cap)
# AI_FAKE=1                                 (canned replies, no network; E2E sets this)

# --- Supabase local stack (read by `supabase start`) ---
# Secret key of the local stack (`make supabase-status`). Only the E2E fixture uses it, to create
# test users through the Auth admin API. Never set it in production: nothing in the apps needs it.
SUPABASE_SECRET_KEY=
# GitHub OAuth app for "Sign in with GitHub". Callback URL: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- Frontend (app/frontend, read by Vite; baked in at build time) ---
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
